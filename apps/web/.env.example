# =============================================================================
# DataMind AI - Web (Next.js) environment example
# Copy to .env.local and adjust.
# =============================================================================

# --- Auth.js (NextAuth) ------------------------------------------------------
# Base URL of the web app.
NEXTAUTH_URL=http://localhost:3000
# MUST be identical to services/api AUTH_SECRET so the backend can verify JWTs.
NEXTAUTH_SECRET=change-me-in-production-use-a-long-random-string
AUTH_SECRET=change-me-in-production-use-a-long-random-string

# --- Backend API -------------------------------------------------------------
# Server-side base URL used by the API client / auth callbacks.
API_BASE_URL=http://localhost:8000/api/v1
# Public base URL exposed to the browser (defaults to API_BASE_URL if unset).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Google OAuth (optional) -------------------------------------------------
# Leave blank for local dev; Credentials (email/password) works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
