# =============================================================================
# DataMind AI - Root environment example
# Copy to .env and adjust. Individual apps also have their own .env.example.
# =============================================================================

# --- Shared secret used to sign/verify Auth.js JWTs (frontend <-> backend) ---
# Must be IDENTICAL in apps/web (AUTH_SECRET) and services/api (AUTH_SECRET).
AUTH_SECRET=change-me-in-production-use-a-long-random-string

# --- Postgres (used when running via docker compose) ---
POSTGRES_USER=datamind
POSTGRES_PASSWORD=datamind
POSTGRES_DB=datamind
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=datamind
MINIO_ROOT_PASSWORD=datamind-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
