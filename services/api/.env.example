# =============================================================================
# DataMind AI - backend environment (services/api)
# Copy to .env. Defaults run fully locally with NO paid credentials.
# =============================================================================

# --- App ---
APP_NAME=DataMind AI API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (the frontend).
CORS_ORIGINS=http://localhost:3000

# --- Auth (must match apps/web AUTH_SECRET exactly) ---
AUTH_SECRET=change-me-in-production-use-a-long-random-string
# HS256 is used to verify Auth.js JWTs signed with the shared secret.
JWT_ALGORITHM=HS256

# --- Database ---
# Default: local SQLite file (no setup required).
DATABASE_URL=sqlite:///./.data/datamind.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://datamind:datamind@localhost:5432/datamind

# --- Storage ---
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.data/storage
# S3 / MinIO (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=datamind
S3_SECRET_KEY=datamind-secret
S3_BUCKET=datamind
S3_REGION=us-east-1

# --- AI ---
# mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
