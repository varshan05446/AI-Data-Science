{
  "name": "datamind-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DataMind AI - an AI-powered Data Science Operating System",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "seed": "node scripts/seed.mjs",
    "dev:web": "pnpm --filter @datamind/web dev",
    "build:web": "pnpm --filter @datamind/web build",
    "lint:web": "pnpm --filter @datamind/web lint",
    "typecheck:web": "pnpm --filter @datamind/web typecheck",
    "dev:api": "cd services/api && uvicorn app.main:app --reload --port 8000",
    "seed:api": "cd services/api && python -m app.seed",
    "test:api": "cd services/api && pytest -q",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
